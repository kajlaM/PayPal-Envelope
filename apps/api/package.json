{
  "name": "@paypalvault/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express API: vault routes, webhooks, Socket.IO (Steps 5, 9)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "setup:checkout": "tsx scripts/setup-checkout.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "openapi": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@paypalvault/agents": "*",
    "@paypalvault/audit": "*",
    "@paypalvault/db": "*",
    "@paypalvault/paypal": "*",
    "@paypalvault/policy": "*",
    "cors": "2.8.6",
    "express": "5.3.0",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6"
  }
}
