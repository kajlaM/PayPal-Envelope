{
  "name": "kubepay-ai",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:generate": "npm run generate -w @kubepay/db",
    "db:migrate": "npm run migrate -w @kubepay/db",
    "db:deploy": "npm run deploy -w @kubepay/db",
    "db:seed": "npm run seed -w @kubepay/db",
    "db:studio": "npm run studio -w @kubepay/db",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "api:dev": "npm run dev -w @kubepay/api",
    "api:start": "npm run start -w @kubepay/api",
    "web:dev": "npm run dev -w @kubepay/web",
    "web:build": "npm run build -w @kubepay/web",
    "site:dev": "tsx watch paypal-interface/server.ts",
    "site:start": "tsx paypal-interface/server.ts",
    "tunnel": "npx -y cloudflared tunnel --url http://localhost:3000",
    "up": "tsx scripts/up.mts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
