# PayPal (sandbox app linked to Paypal-Wallet-Platform)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Both webhook ids come from: npm run setup:webhooks -w packages/paypal -- https://<public-api-url>
PAYPAL_WEBHOOK_ID=
PAYPAL_UTILITY_PLAN_ID=

# PayPal (sandbox app linked to city-utility, used only to send invoices)
UTILITY_CLIENT_ID=
UTILITY_CLIENT_SECRET=
UTILITY_WEBHOOK_ID=

# Sandbox account emails
PLATFORM_SANDBOX_EMAIL=
USER_SANDBOX_EMAIL=
AUDIO_STORE_SANDBOX_EMAIL=
CITY_UTILITY_SANDBOX_EMAIL=

# AI + sponsor tools
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash,gemini-3.6-flash,gemini-3.5-flash-lite
CHANNEL3_API_KEY=
KERNEL_API_KEY=
ELASTIC_URL=
ELASTIC_API_KEY=
ZAPIER_HOOK_URL=
# Dashboard address used in Zapier alert links (default http://localhost:5173)
DASHBOARD_URL=

# Postgres
DATABASE_URL=

# API server
PORT=4000
INTERNAL_API_KEY=
# Where agents reach the PayPalVault API (default http://localhost:$PORT)
PAYPALVAULT_API_URL=
# Shopping agent: also search the demo store (price trap, price drop) when a Channel3 key is set
DEMO_STORE=
# Dashboard (apps/web): API address, and the public PayPal client id (defaults to PAYPAL_CLIENT_ID)
VITE_API_URL=
VITE_PAYPAL_CLIENT_ID=
# off = the API does not run its own 1-minute tick (sweeper + agent watch); use the apps/sweeper cron instead
BACKGROUND_JOBS=

# Alert emails (apps/api/src/services/notify.ts, sent through ZAPIER_HOOK_URL)
# Owner's PayPal sandbox email = their real inbox (To), comma separated
ALERT_RECIPIENTS=
# Everyone who gets a copy of every alert (CC), comma separated
ALERT_CC=
# Where "Open the vault" links and the Approve / Reject / Pick buttons in alert emails point
# (npm run up sets it to the Cloudflare link). The buttons are signed with INTERNAL_API_KEY.
SITE_URL=
# How vaults pay shops: PayPal Checkout (buyer protection) once `npm run setup:checkout -w apps/api`
# has saved the platform account, else Payouts. Set to "payouts" to always use Payouts.
MERCHANT_PAYMENTS=
# Time zone for dates in emails (default Asia/Kolkata)
ALERT_TIMEZONE=
