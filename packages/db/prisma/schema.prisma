generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// All money is stored as integer cents (USD).

enum VaultType {
  SHOPPING
  UTILITY
  SAVINGS // only saves towards a goal; never spends
}

enum VaultStatus {
  PENDING_FUNDING
  SAVING // paid into over time; becomes ACTIVE when it holds its full amount
  ACTIVE
  EXPIRED
  LIQUIDATED
}

enum SavingsInterval {
  DAY
  WEEK
  MONTH
}

enum LedgerType {
  FUND      // money in: user -> vault (Orders capture or subscription payment)
  SPEND     // money out: vault -> merchant (Payouts)
  LIQUIDATE // money out: vault -> user (Payouts, leftover balance)
}

enum LedgerStatus {
  PENDING   // waiting for PayPal to confirm
  COMPLETED // PayPal confirmed
  FAILED    // PayPal failed; any held amount is back in the vault
}

enum DecisionResult {
  APPROVE
  BLOCK
  NEEDS_HUMAN
}

model User {
  id          String   @id @default(cuid())
  name        String
  paypalEmail String   @unique
  createdAt   DateTime @default(now())
  vaults      Vault[]

  @@map("users")
}

model Vault {
  id                   String        @id @default(cuid())
  userId               String
  name                 String
  type                 VaultType
  budgetCents          Int
  balanceCents         Int           @default(0)
  status               VaultStatus   @default(PENDING_FUNDING)
  expiresAt            DateTime
  paypalSubscriptionId String?       @unique
  // Agent watch mode (Step 8): when the agent should look again, and how the last run ended
  nextAgentRunAt       DateTime?
  lastAgentRunAt       DateTime?
  lastAgentOutcome     String?
  // Paying in over time (savings): the saved PayPal account is charged this much every interval
  savingsPerPaymentCents Int?
  savingsEvery           SavingsInterval?
  nextChargeAt           DateTime?
  chargeFailures         Int              @default(0) // declined payments in a row
  savingsPausedAt        DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  user                 User          @relation(fields: [userId], references: [id])
  policies             Policy[]
  ledger               LedgerEntry[]
  decisions            Decision[]
  proposals            Proposal[]
  fundRequests         FundRequest[]

  @@index([status, expiresAt])
  @@index([status, nextAgentRunAt])
  @@index([status, nextChargeAt])
  @@map("vaults")
}

model Policy {
  id         String   @id @default(cuid())
  vaultId    String
  version    Int
  policyJson Json
  sourceText String?
  createdAt  DateTime @default(now())
  vault      Vault    @relation(fields: [vaultId], references: [id])

  @@unique([vaultId, version])
  @@map("policies")
}

model LedgerEntry {
  id          String       @id @default(cuid())
  vaultId     String
  type        LedgerType
  status      LedgerStatus @default(PENDING)
  amountCents Int
  paypalRef   String?      @unique // order id, capture id, sale id or payout item id
  merchantId  String?
  decisionId  String?      @unique
  itemId      String?      // shopping-list vaults: the list item this payment buys
  paidVia     String?      // SPEND: CHECKOUT (PayPal Checkout purchase, paypalRef = capture id) or PAYOUTS
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  vault       Vault        @relation(fields: [vaultId], references: [id])
  merchant    Merchant?    @relation(fields: [merchantId], references: [id])
  decision    Decision?    @relation(fields: [decisionId], references: [id])

  @@index([vaultId, createdAt])
  @@map("ledger_entries")
}

model Merchant {
  id           String        @id @default(cuid())
  name         String        @unique
  category     String
  sandboxEmail String
  domain       String?       // real shop website, e.g. bestbuy.com (product search)
  approved     Boolean       @default(true)
  ledger       LedgerEntry[]

  @@map("merchants")
}

model Decision {
  id          String         @id @default(cuid())
  vaultId     String
  requestJson Json
  result      DecisionResult
  reasons     String[]
  resolvedBy  String?        // set when a human approves/rejects a NEEDS_HUMAN decision
  createdAt   DateTime       @default(now())
  vault       Vault          @relation(fields: [vaultId], references: [id])
  ledgerEntry LedgerEntry?

  @@index([vaultId, createdAt])
  @@map("decisions")
}

enum ProposalStatus {
  OPEN      // waiting for the owner to pick one
  CHOSEN    // the owner picked one (decisionId says how the purchase went)
  REJECTED  // the owner wants none of them: the agent looks again
  CANCELLED // replaced by newer options, or the rules changed
}

// "Ask me" vaults: the agent's top options (max 3, each with pros and cons) for the owner to pick from.
model Proposal {
  id          String         @id @default(cuid())
  vaultId     String
  itemId      String?        // shopping-list vaults: which item the options are for
  options     Json           // [{ title, merchant, price, url, category, rating, delivery_days, condition, verified_price, pros, cons }]
  summary     String?
  status      ProposalStatus @default(OPEN)
  chosenIndex Int?
  decisionId  String?
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?
  vault       Vault          @relation(fields: [vaultId], references: [id])

  @@index([vaultId, status])
  @@map("proposals")
}

enum FundRequestStatus {
  OPEN      // sent; waiting for the friend to pay it on PayPal
  PAID      // the friend paid: the money is in the vault (FUND entry, paypalRef = invoiceId)
  CANCELLED // the owner cancelled it, paid another way, or the vault expired first
}

// "Ask a friend": a PayPal money request (Invoicing API, sent by the KubePay platform account) to a
// friend's PayPal email. When the friend pays it, the money goes straight into this vault.
model FundRequest {
  id            String            @id @default(cuid())
  vaultId       String
  invoiceId     String            @unique // PayPal invoice id
  payerEmail    String            // the friend's PayPal account
  requesterName String?
  message       String?
  amountCents   Int
  payUrl        String?           // PayPal page where the friend pays
  status        FundRequestStatus @default(OPEN)
  createdAt     DateTime          @default(now())
  resolvedAt    DateTime?
  vault         Vault             @relation(fields: [vaultId], references: [id])

  @@index([vaultId, status])
  @@index([payerEmail, status])
  @@map("fund_requests")
}

// A customer's PayPal account saved with the Vault API (payment token), so KubePay can charge it
// without a popup: the first payment into a vault, top-ups, and savings payments.
model PaypalLink {
  email          String   @id // the PayPal (sandbox) account; matches User.paypalEmail
  username       String?  // site login that linked it
  paymentTokenId String
  customerId     String
  linkedAt       DateTime

  @@map("paypal_links")
}

model PaypalEvent {
  id         String   @id // PayPal webhook event id, so replays are ignored
  type       String
  payload    Json
  processed  Boolean  @default(false)
  receivedAt DateTime @default(now())

  @@map("paypal_events")
}
